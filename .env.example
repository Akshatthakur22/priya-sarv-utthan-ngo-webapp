# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
# Inbox that receives job/contact/support alerts (defaults to EMAIL_USER)
NOTIFY_EMAIL=your-email@gmail.com

# Razorpay Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Admin Configuration
ADMIN_API_KEY=your-secure-admin-key-change-this-in-production
ADMIN_JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional: Together AI API Key (for chatbot functionality)
TOGETHER_API_KEY=your_together_ai_api_key

# Production Settings (uncomment for production)
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
# NODE_ENV=production
